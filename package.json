{
  "name": "@bill_nee/dwg-reader",
  "version": "1.5.1",
  "description": "直接读取 AutoCAD DWG/DXF、PDF 与图片/截屏的 DSH 插件（DWG 基于 libredwg-web 0.8.2 WASM，DXF 基于 Python ezdxf 桥接，PDF 基于 pdf-parse，图片基于内置 tesseract.js WASM OCR，支持本地 tessdata 多语言，GPL-3.0）。",
  "license": "GPL-3.0-only",
  "author": "MEB 工程造价项目助手 <meb@example.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NIDEXIANG/dwg-reader-plugin-20261029.git"
  },
  "keywords": [
    "dwg",
    "dwg-reader",
    "autocad",
    "cad",
    "dsh-plugin",
    "libredwg",
    "wasm"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "vendor",
    "scripts/*.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  }
}
